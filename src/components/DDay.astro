---
// D-day under the calendar: D-number by Korean calendar date, and a small line counting down to the ceremony time.
import { wedding as w } from '../data/wedding';
const kstDay = (d: Date) => Date.parse(new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(d));
const left = Math.round((kstDay(new Date(w.date)) - kstDay(new Date())) / 864e5);
const label = left > 0 ? `D-${left}` : left === 0 ? 'D-DAY' : `D+${-left}`;
---
<div class="dday" data-date={w.date}>
  <strong class="dday-num">{label}</strong>
  <span class="dday-line" aria-live="off">결혼식까지 <b data-k="d">{Math.max(0, left)}</b>일 <b data-k="h">00</b>시간 <b data-k="m">00</b>분 <b class="dday-sec" data-k="s">00</b>초</span>
</div>
<script>
  const box = document.querySelector<HTMLElement>('.dday');
  if (box) {
    const when = new Date(box.dataset.date!);
    const kstDay = (d: Date) => Date.parse(new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(d));
    const pad = (n: number) => String(n).padStart(2, '0');
    const num = box.querySelector<HTMLElement>('.dday-num')!;
    const line = box.querySelector<HTMLElement>('.dday-line')!;
    const tick = () => {
      const now = new Date();
      const days = Math.round((kstDay(when) - kstDay(now)) / 864e5);
      num.textContent = days > 0 ? `D-${days}` : days === 0 ? 'D-DAY' : `D+${-days}`;
      const ms = when.getTime() - now.getTime();
      if (ms <= 0) {
        line.textContent = days === 0 ? '오늘, 저희 결혼합니다' : `부부가 된 지 ${-days}일째예요`;
        return;
      }
      const v: Record<string, string> = { d: String(Math.floor(ms / 864e5)), h: pad(Math.floor(ms / 36e5) % 24), m: pad(Math.floor(ms / 6e4) % 60), s: pad(Math.floor(ms / 1e3) % 60) };
      line.querySelectorAll<HTMLElement>('[data-k]').forEach(el => { el.textContent = v[el.dataset.k!]; });
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
<style>
  .dday { display:flex; flex-direction:column; align-items:center; gap:8px; margin:30px 0 6px; }
  .dday-num { display:flex; align-items:center; gap:14px; font:400 27px/1 var(--serif); letter-spacing:1px; color:var(--green); font-variant-numeric:tabular-nums; }
  .dday-num::before, .dday-num::after { content:""; width:34px; height:1px; background:currentColor; opacity:.35; }
  .dday-line { font-size:12px; line-height:1.6; letter-spacing:.2px; color:var(--muted); font-variant-numeric:tabular-nums; }
  .dday-line :global(b) { font-weight:500; font-size:13px; color:var(--ink, inherit); }
  .dday-line :global(.dday-sec) { color:var(--green); }
</style>
