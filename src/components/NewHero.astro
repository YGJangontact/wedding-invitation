---
import {wedding as w} from '../data/wedding';
const {theme,names,fullDate,time,asset}=Astro.props;
---
<header class:list={['new-hero',`new-hero-${theme}`]}>
  {theme==='garden-refined' && <>
    <p class="hero-whisper">함께 맞이할 모든 계절</p>
    <div class="refined-photo">
      {w.heroPhoto ? <img src={asset(w.heroPhoto)} alt="두 사람의 대표 사진" fetchpriority="high"/> : <>
        <svg class="botanical" viewBox="0 0 240 280" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M115 252C122 191 84 129 103 54M117 248C125 194 161 162 167 91M114 208C88 205 72 182 71 164C94 167 110 182 114 208ZM110 174C131 156 134 134 125 118C111 131 104 150 110 174ZM100 133C75 128 64 107 66 91C86 98 98 113 100 133ZM146 166C165 166 183 148 185 132C165 137 151 149 146 166Z"/><path d="M103 58C77 47 86 28 102 38C104 11 125 16 118 38C142 31 144 53 121 56C136 75 115 88 108 67C97 87 79 73 103 58ZM167 93C148 86 152 72 165 78C166 59 182 62 178 78C195 73 197 90 180 92C188 106 172 112 169 98C161 113 148 101 167 93Z"/></g></svg>
        <span class="photo-note-ko">대표 사진이 들어갈 자리</span>
      </>}
    </div>
    <h1>{names}</h1>
  </>}
  {theme==='ribbon' && <>
    <svg class="ribbon-drawing" viewBox="0 0 300 140" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.3"><path d="M145 64C98 15 43 20 57 56C68 82 115 76 145 64ZM155 64C201 15 257 20 243 56C232 82 185 76 155 64Z"/><path d="M143 70C127 92 109 107 78 127L88 102L67 104C95 87 118 77 143 70ZM157 70C176 97 197 116 224 131L215 105L237 109C207 89 182 77 157 70Z"/><ellipse cx="150" cy="65" rx="9" ry="12"/></g></svg>
    <p class="hero-whisper">소중한 당신을 초대합니다</p>
    <h1>{names}</h1>
    <p class="ribbon-letter">서로의 곁에서<br/>새로운 날들을 함께 시작합니다.</p>
    <div class="ribbon-photo">{w.heroPhoto ? <img src={asset(w.heroPhoto)} alt="두 사람의 대표 사진" fetchpriority="high"/> : <span>우리의 사진 한 장</span>}</div>
  </>}
  {theme==='editorial' && <>
    <div class="editorial-masthead"><span>우리의 결혼</span><span>한 장의 기록</span></div>
    <h1>{names}<span>함께, 다음 장으로.</span></h1>
    <div class="editorial-photo">{w.heroPhoto ? <img src={asset(w.heroPhoto)} alt="두 사람의 대표 사진" fetchpriority="high"/> : <><span class="frame-corner"></span><p>한 장의 사진으로<br/>시작하는 우리의 이야기</p><small>대표 사진을 준비 중입니다</small></>}</div>
  </>}
  <div class="new-hero-details"><p>{fullDate}<br/><strong>{time}</strong></p><p>{w.city} {w.venue}<br/><span>{w.hall}</span></p></div>
  <a class="new-hero-next" href="#invitation">초대의 글 읽기 <span aria-hidden="true">↓</span></a>
</header>
