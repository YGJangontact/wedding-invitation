---
import { wedding as w } from '../data/wedding';
import NaverMap from './NaverMap.astro';
import AtmMap from './AtmMap.astro';
const query = encodeURIComponent(w.address);
const parkingQuery = encodeURIComponent('서울특별시 중구 칠패로 5 서소문공원 주차장');
---
<section id="location" class="location">
  <p class="eyebrow">만나는 곳</p>
  <h2>{w.venue}</h2>
  <div class="venue-address-row">
    <p class="street-address">{w.address.replace('서울특별시', '서울')} {w.hall}</p>
    <button class="address-copy" data-copy={`${w.address} ${w.hall}`}>복사</button>
  </div>
  <NaverMap />
  <div class="map-links">
    <a href={`https://map.naver.com/p/search/${query}`} target="_blank" rel="noopener noreferrer">네이버 지도 ↗</a>
    <a href={`https://map.kakao.com/link/search/${query}`} target="_blank" rel="noopener noreferrer">카카오맵 ↗</a>
  </div>
  <div class="travel-options">
    {w.transport.map((item,i)=><details open={i===0}>
      <summary><span><span class="travel-head"><strong>{item.title}</strong>{item.badges?.map(b=><span class:list={['badge',{key:b.key}]}>{b.text}</span>)}</span><small class:list={{"parking-summary": !!item.highlights}}>{item.summary}</small></span><span class="detail-toggle" aria-hidden="true">+</span></summary>
      <div class="travel-content">
        {item.highlights && <div class="parking-notice">{item.highlights.map(line=><span>{line}</span>)}</div>}
        <p>{item.text}</p>{i===2 && <a class="parking-link" href={`https://map.naver.com/p/search/${parkingQuery}`} target="_blank" rel="noopener noreferrer">별관 주차장 지도 ↗</a>}</div>
    </details>)}
    <details class="atm-details">
      <summary><span><span class="travel-head"><strong>ATM 안내</strong>{w.atmBadges.map(b=><span class:list={['badge',{key:b.key}]}>{b.text}</span>)}</span><small>예식장 내부에는 ATM이 없습니다</small></span><span class="detail-toggle" aria-hidden="true">+</span></summary>
      <div class="travel-content">
        <p class="atm-intro">현금이 필요하시면 건물 1층 이마트24 편의점 외부 또는 가까운 우리은행 ATM을 확인해 주세요.</p>
        <AtmMap />
        <div class="atm-list">
          {w.nearbyAtms.map((atm,index)=><a href={`https://map.naver.com/p/search/${encodeURIComponent(atm.query)}`} target="_blank" rel="noopener noreferrer">
            <span><strong>{index+1}. {atm.name}</strong><small>{atm.detail}</small><small class="atm-map-label">네이버 지도 보기 ↗</small></span>
          </a>)}
        </div>
        <p class="atm-note">일요일 이용 가능 여부와 운영시간은 방문 전 확인해 주세요. 기기·은행에 따라 수수료가 발생할 수 있습니다.</p>
      </div>
    </details>
  </div>
  <div class="venue-help" aria-label="예식장 연락처와 공식 안내">
    <a href={`tel:${w.venuePhone}`}>예식장 전화 <span>{w.venuePhone}</span></a>
    <span class="venue-help-divider" aria-hidden="true">|</span>
    <a href={w.locationSource} target="_blank" rel="noopener noreferrer">공식 오시는 길 ↗</a>
  </div>
</section>
<script>
  import { installNaverMapLinks } from '../lib/naverMapLinks.mjs';
  installNaverMapLinks();
</script>
<style>
  .atm-list { display:grid;gap:8px;margin:16px 0 8px; }
  .atm-list a { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px;border:1px solid var(--line);border-radius:4px;text-decoration:none;color:var(--ink); }
  .atm-list strong { display:block;font-size:13px;line-height:1.6;font-weight:600;word-break:keep-all; }
  .atm-list small { display:block;margin-top:4px;font-size:12px;color:var(--muted); }
  .travel-content .atm-note { margin:8px 0 0;font-size:12px;line-height:1.7;color:var(--muted);word-break:keep-all; }

  .travel-head { display:flex;flex-wrap:wrap;align-items:center;gap:6px 7px; }
  .travel-head strong { display:inline; }
  .badge { display:inline-block;padding:3px 8px;border:1px solid currentColor;border-radius:99px;font-size:10.5px;line-height:1.2;font-weight:500;white-space:nowrap;color:var(--muted); }
  .badge.key { color:var(--green); }

  .parking-notice { display:grid;gap:4px;margin:0 0 20px;text-align:left;word-break:keep-all; }
  .parking-notice span { color:var(--ink);font-size:14px;font-weight:400;line-height:1.8; }
  .atm-list .atm-map-label { margin-top:8px;text-decoration:underline;text-underline-offset:3px; }

  .venue-help { display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0 8px;margin-top:20px;font-size:11px;line-height:1.6;color:var(--muted); }
  .venue-help a { display:inline-flex;align-items:center;gap:4px;min-height:44px;color:inherit;text-decoration:underline;text-underline-offset:3px;white-space:nowrap; }
  .venue-help-divider { opacity:.45; }

  .venue-address-row { display:flex; align-items:center; justify-content:center; gap:6px; margin:10px 0 0; padding:0; }
  .venue-address-row .street-address { margin:0; min-width:0; font-size:11px; line-height:1.5; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .venue-address-row .address-copy { flex:none; margin:0; padding:0 8px; min-height:22px; font-size:10px; line-height:20px; border-radius:11px; }
</style>
