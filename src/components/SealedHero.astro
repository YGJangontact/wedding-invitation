---
import {wedding as w} from '../data/wedding';
const {asset,fullDate,time,guestView}=Astro.props;
---
<header class="sealed-intro">
  <div class="ivory-petals" aria-hidden="true">
    {[5,89,12,95,8,84].map((x,i) => <i style={`left:${x}%;top:${i*13}%;animation-delay:-${i*1.7}s`}/>)}
  </div>
  <div class="studio-cover">
    <img src={asset(w.heroPhoto)} width="2000" height="1333" fetchpriority="high" alt="두 사람의 대표 사진" />
    <div class="cover-letter">
  <h1>우리의 다음 장을<br/>열어주세요</h1>

    </div>
  </div>
  <div class="sealed-date"><p>{fullDate} · {time}<br/>{w.city} {w.venue} · {w.hall}</p></div>
  <div class="envelope-space" id={guestView ? "invitation" : undefined}>
    <div class="sealed-envelope">
      <div class="envelope-back"></div>
      <div class="reveal-card">
        <div class="letter-body">
          {w.invitation.filter(Boolean).map(line => <p>{line}</p>)}
          {w.names.every(Boolean) && <small>{w.names.join(' · ')}</small>}
        </div>
      </div>
      <div class="envelope-front"></div>
      <div class="sealed-flap"></div>
      <div class="silk-band" aria-hidden="true"></div>
      <span class="wax-seal" aria-hidden="true">❦</span>
    </div>
  </div>
</header>
<script>
  const envelope = document.querySelector<HTMLElement>('.sealed-envelope');
  if (envelope) {
    let frame = 0;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    let progress: number | undefined;
    let previousTime = performance.now();
    function ease(value: number) {
      const t = clamp(value);
      return t * t * (3 - 2 * t);
    }
    function paint(now: number) {
      frame = 0;
      const top = envelope!.getBoundingClientRect().top;
      const height = window.innerHeight;
      const target = clamp((height * 0.91 - top) / (height * 0.58));
      const elapsed = Math.min(48, now - previousTime);
      previousTime = now;
      const current = progress ?? target;
      progress = Math.abs(target - current) < 0.002 ? target :
        current + (target - current) * (1 - Math.exp(-elapsed / 85));
      const release = ease(progress / 0.48);
      const unfold = ease((progress - 0.15) / 0.52);
      const lift = ease((progress - 0.34) / 0.66);
      const style = envelope!.style;
      style.setProperty('--seal-opacity', String(1 - release));
      style.setProperty('--thread-drift', release * 38 + 'px');
      style.setProperty('--flap-angle', -172 * unfold + 'deg');
      style.setProperty('--letter-y', 18 - 123 * lift + 'px');
      style.setProperty('--letter-opacity', String(ease((progress - 0.45) / 0.36)));
      style.setProperty('--letter-layer', progress >= 0.45 ? '5' : '2');
      if (progress === 1) {
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', schedule);
      } else if (progress !== target) {
        schedule();
      }
    }
    function schedule() {
      if (!frame) frame = requestAnimationFrame(paint);
    }
    window.addEventListener('scroll', schedule, {passive: true});
    window.addEventListener('resize', schedule);
    paint(performance.now());
  }
</script>
<style>
 .sealed-intro{position:relative;isolation:isolate;}
 .studio-cover{animation:studio-light 1.45s ease-out both;}
 @keyframes studio-light{from{filter:brightness(.69)}to{filter:brightness(1)}}
 .ivory-petals{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden;}
 .ivory-petals i{position:absolute;width:9px;height:16px;border-radius:75% 22% 70% 35%;background:linear-gradient(125deg,#fff,#fffdf1 55%,#e3decb);box-shadow:0 1px 3px #6c60422b;animation:ivory-drift 9s ease-in-out infinite;}
 @keyframes ivory-drift{0%{opacity:0;transform:translateY(-45px) rotate(-35deg)}18%{opacity:.85}65%{transform:translate(10px,105px) rotate(55deg)}100%{opacity:0;transform:translate(-7px,180px) rotate(100deg)}}

 .sealed-intro{padding:48px 24px 32px;text-align:center;background:radial-gradient(ellipse at 20% 20%,#fffefa,#f2ede5);color:#625540;overflow:hidden;}
 .studio-cover{position:relative;margin:-48px -24px 0;}
 .studio-cover img{display:block;width:100%;height:auto;}
 .cover-letter{position:relative;margin-top:30px;color:#433832;}
 .cover-letter h1{font-size:clamp(19px,4.7vw,25px);line-height:1.45;}
 .cover-letter .sealed-subtitle{margin:10px 0 0;font-size:12px;color:#514640;}
 @media(max-width:360px){.studio-cover{margin-inline:-20px;}}
 h1{font:32px/1.65 var(--serif);letter-spacing:-1px;margin:0;}
 .sealed-subtitle{font:13px/1.8 var(--serif);margin:12px 0 0;color:#857867;}
 .envelope-space{height:350px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:30px;perspective:1100px;}
 .sealed-envelope{position:relative;width:100%;max-width:340px;height:210px;isolation:isolate;}
 .envelope-back{position:absolute;inset:0;background:#e8dfd1;border:1px solid #dacdbc;box-shadow:0 18px 35px #69543d20;}
 .envelope-front{position:absolute;inset:0;z-index:3;background:linear-gradient(32deg,#f4eee3 49.7%,transparent 50%),linear-gradient(-32deg,#e9dfd0 49.7%,#f9f4eb 50%);border:1px solid #ded2c1;transition:opacity .5s 1.4s;}
 .sealed-flap{position:absolute;inset:0;z-index:4;background:#fff9ee;clip-path:polygon(0 0,100% 0,50% 62%);transform-origin:top;transition:transform 1s .35s,z-index 0s .85s;backface-visibility:hidden;}
 .silk-band{position:absolute;inset:0 auto 0 45%;width:10%;z-index:5;background:linear-gradient(90deg,#e6dfd3,#fffdf7 45%,#ede6da);box-shadow:1px 0 3px #8b776b20;transition:transform .85s .1s,opacity .6s;}
 .wax-seal{position:absolute;z-index:6;left:calc(50% - 31px);top:85px;width:62px;height:62px;border-radius:48% 52% 47% 53%;border:4px double #cfb98c;background:radial-gradient(circle at 30% 25%,#e8d4a5,#b6955e);color:#786039;box-shadow:0 5px 12px #7b603640,inset 0 0 0 3px #f6e1b850;font:32px Georgia;cursor:pointer;transition:transform .6s,opacity .6s;}
 .wax-seal:focus-visible{outline:3px solid #806841;outline-offset:6px;}
 .reveal-card{position:absolute;z-index:2;inset:10px 20px auto;padding:12px 12px 16px;background:#fffdfa;box-shadow:0 8px 20px #725c3c20;opacity:0;transform:translateY(25px) scale(.92);transition:transform 1.3s .85s,opacity .6s .7s;}
 .letter-body{padding:24px 0;color:#51473b;font:14px/1.85 var(--serif);word-break:keep-all;}
 .letter-body p{margin:0;}
 .letter-body p:last-of-type{margin-top:14px;}
 /* Without script, show the unfolded letter in its reading position. */
 .wax-seal{display:grid;place-items:center;opacity:var(--seal-opacity,0);pointer-events:none;}
 .silk-band{left:50%;width:2px;background:#a44d52;box-shadow:none;opacity:var(--seal-opacity,0);transform:translateX(var(--thread-drift,38px)) rotate(-4deg);}
 .sealed-flap{transform:rotateX(var(--flap-angle,-172deg));}
 .reveal-card{opacity:var(--letter-opacity,1);transform:translateY(var(--letter-y,-105px));z-index:var(--letter-layer,5);}
 .wax-seal,.silk-band,.sealed-flap,.reveal-card{transition:none;}
 .sealed-date{border-top:1px solid #dbd1c1;padding-top:18px;font:15px/1.8 var(--serif);color:#493f33;}
 @media(max-width:360px){h1{font-size:28px}.sealed-intro{padding-inline:20px}.sealed-envelope{height:190px}.envelope-space{height:335px}.wax-seal{top:73px}}
</style>
