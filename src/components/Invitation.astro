---
import DDay from './DDay.astro';
import Gift from './Gift.astro';
import PhotoSwipe from './PhotoSwipe.astro';
import { wedding as w } from '../data/wedding';
import '../styles/global.css';
import Guestbook from './Guestbook.astro';
import Location from './Location.astro';
import '../styles/themes.css';
import '../styles/new-themes.css';
import NewHero from './NewHero.astro';
import InvitationMotion from './InvitationMotion.astro';
import SeasonStory from './SeasonStory.astro';
import ShareMeta from './ShareMeta.astro';
import SealedHero from './SealedHero.astro';
import BackgroundMusic from './BackgroundMusic.astro';
import YouTubeMusic from './YouTubeMusic.astro';
import {themes as choices,sitePath,scrollThemes} from '../data/themes';
import ScrollThemes from './ScrollThemes.astro';
import '../styles/scroll-themes.css';
const { theme = 'garden', sealed = false, guestView = false } = Astro.props;
const showGallery = !guestView || w.photos.length > 0;
const scrollTheme = scrollThemes.includes(theme);
const fresh = choices.some(t=>t.id===theme && t.fresh);
const themeName = choices.find(t=>t.id===theme)?.name;
const asset = (path: string) => path.startsWith('/') ? import.meta.env.BASE_URL.replace(/\/$/, '') + path : path;
const names = w.names.every(Boolean) ? w.names.join(' · ') : '두 사람의 이름';
const date = new Date(w.date);
const year = Number(new Intl.DateTimeFormat('en',{timeZone:'Asia/Seoul',year:'numeric'}).format(date));
const month = Number(new Intl.DateTimeFormat('en',{timeZone:'Asia/Seoul',month:'numeric'}).format(date));
const day = Number(new Intl.DateTimeFormat('en',{timeZone:'Asia/Seoul',day:'numeric'}).format(date));
const fullDate = new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',year:'numeric',month:'long',day:'numeric',weekday:'long'}).format(date);
const time = new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',hour:'numeric',minute:'2-digit'}).format(date);
const offset = new Date(Date.UTC(year,month-1,1)).getUTCDay();
const days = new Date(Date.UTC(year,month,0)).getUTCDate();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <ShareMeta />
    <title>{w.names.every(Boolean) ? `${names}의 결혼식` : guestView ? '우리의 결혼식에 초대합니다' : `${themeName} — 모바일 청첩장 시안`}</title>
    <meta name="description" content={`${fullDate} ${time}, ${w.city} ${w.venue}에서 함께해 주세요.`} />
  </head>
  <body data-theme={theme} class:list={{'fresh-theme':fresh}}>
    <a class="skip" href="#invitation">본문으로 이동</a>
    <aside class="desktop-note"><span class="small-flower">✳</span><p>우리의 시작을<br/>한 장에 담아.</p><span>모바일 청첩장 · {guestView ? fullDate : themeName}</span></aside>
    <main>
      {!guestView && <details class="theme-menu"><summary><span>{themeName}</span><span>디자인 바꾸기</span></summary><nav aria-label="디자인 비교">{[true,false].map(group=><div><p>{group?'새로운 후보':'기존 시안'}</p>{choices.filter(t=>t.fresh===group).map(t=><a href={sitePath(`designs/${t.id}/`)} aria-current={theme===t.id?'page':undefined}>{t.name}</a>)}</div>)}<a class="compare-all" href={sitePath('designs/')}>{choices.length}가지 한눈에 비교</a></nav></details>}
      {!guestView && <div class="draft-banner">청첩장 시안 <span>이름은 준비 중이에요</span></div>}
      {sealed ? <SealedHero guestView={guestView} asset={asset} fullDate={fullDate} time={time}/> : fresh ? <NewHero theme={theme} names={names} fullDate={fullDate} time={time} asset={asset}/> : <header class="hero">
        <div class="hero-top"><span>우리의 시작</span><span>{year}. {String(month).padStart(2,'0')}. {String(day).padStart(2,'0')}</span></div>
        {theme !== 'garden' && <div class="theme-intro"><p>{theme==='classic'?'THE WEDDING INVITATION':'SAVE OUR DATE'}</p><span>{theme==='classic'?'초대합니다':'05 / 09'}</span></div>}
        <div class:list={['hero-photo', { 'has-photo': w.heroPhoto }]}>
          {w.heroPhoto ? <img src={asset(w.heroPhoto)} alt="두 사람의 대표 사진" fetchpriority="high" /> : <div class="photo-placeholder"><div class="arch"><span class="stem stem-one"></span><span class="stem stem-two"></span><span class="flower flower-one">✳</span><span class="flower flower-two">✳</span><span class="little-star">✧</span></div><span>이곳에 우리의 사진이 들어갑니다</span></div>}
          <div class="hero-title"><p>함께 맞이할 모든 계절</p><h1>{names}</h1></div>
        </div>
        <div class="hero-bottom"><p>{fullDate}<br/><strong>{time}</strong></p><p>{w.city} {w.venue}<br/><span>{w.hall || '상세 홀 안내는 곧 전해드릴게요'}</span></p></div>
        <a class="scroll-link" href="#invitation">초대의 글 <span>↓</span></a>
      </header>}
      {!guestView && !scrollTheme && <SeasonStory asset={asset} theme={theme}/>}
      {!(guestView && sealed) && <section class="invitation" id="invitation"><span class="ornament">✳</span><p class="eyebrow">소중한 분들께</p><h2>우리의 첫날에<br/>함께해 주세요.</h2><div class="letter">{w.invitation.map(line=>line ? <p>{line}</p> : <br/>)}</div>{(w.names.every(Boolean) || !guestView) && <p class="muted names-note">{w.names.every(Boolean) ? names : '이름과 가족 소개를 나중에 넣을 자리예요'}</p>}</section>}
      <section class="day-section" id="day"><p class="eyebrow">기억해 주세요</p><h2>{year}. {String(month).padStart(2,'0')}. {String(day).padStart(2,'0')}</h2><p>{fullDate.split(' ').at(-1)} {time}</p><div class="calendar" role="group" aria-label={`${year}년 ${month}월 예식 달력`}><div class="calendar-row week">{['일','월','화','수','목','금','토'].map(d=><span >{d}</span>)}</div><div class="calendar-grid">{Array.from({length:offset},()=> <span aria-hidden="true"></span>)}{Array.from({length:days},(_,i)=><span class:list={{selected:i+1===day,holiday:w.holidays.includes(i+1)}} aria-label={i+1===day ? `${month}월 ${day}일 예식일` : undefined}>{i+1===day && <svg class="day-loop" viewBox="0 0 38 34" aria-hidden="true"><path pathLength="1" d="M30 6 C22 1,7 3,4 14 C1 25,13 32,23 30 C33 28,37 18,33 10 C31 6,27 4,24 5"/></svg><svg class="day-heart" viewBox="0 0 30 28" aria-hidden="true"><path d="M15 26 C5 18,1 13,1 8 A6.5 6.5 0 0 1 15 6 A6.5 6.5 0 0 1 29 8 C29 13,25 18,15 26Z"/></svg>}{i+1}</span>)}</div></div><DDay /><p class="date-caption">달력에 작은 약속 하나, 함께해 주세요.</p></section>
      {showGallery && <section class="gallery" id="gallery"><p class="eyebrow">오래 기억할 장면</p><h2>우리의 순간들</h2><p class="muted">함께한 시간을 사진으로 전할게요.</p>{w.photos.length ? <PhotoSwipe asset={asset} /> : <div class="photo-grid"><div class="gallery-placeholder wide"><span>✧</span><p>가장 좋아하는 한 장</p></div><div class="gallery-placeholder"><span>01</span><p>함께 웃던 날</p></div><div class="gallery-placeholder"><span>02</span><p>기억하고 싶은 순간</p></div></div>}</section>}
      <Location />
      <Guestbook />
      {w.contacts.length>0 && <section class="contact"><h2>연락하기</h2>{w.contacts.map(c=><a class="contact-link" href={`tel:${c.phone}`}>{c.label}에게 연락하기</a>)}</section>}<Gift guestView={guestView} />
      <footer><span class="ornament">✳</span><h2>그날, 반갑게 만나요.</h2><p>소중한 걸음과 마음을<br/>오래도록 기억하겠습니다.</p><div class="share-pair" data-kakao-key={w.kakaoJsKey}><div><button type="button" id="share-kakao" class="share-icon kakao" aria-label="카카오톡으로 공유하기"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 2.8 1.9 5.3 4.7 6.7l-1 3.6c-.1.3.3.6.6.4l4.3-2.8c.5.1.9.1 1.4.1 5.5 0 10-3.6 10-8S17.5 3 12 3z"/></svg></button><span aria-hidden="true">카카오톡</span></div><div><button type="button" id="share-link" class="share-icon" aria-label="청첩장 링크 복사"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg></button><span aria-hidden="true">링크 복사</span></div></div>{!guestView && <p class="local-note">이름을 준비 중인 청첩장 시안입니다.</p>}<small>{year}. {String(month).padStart(2,'0')}. {String(day).padStart(2,'0')} · {w.venue}</small></footer>
      {w.music.src && <p class="music-credit">Music: <a href="https://incompetech.com/music/royalty-free/index.html?isrc=USUAN1400037" target="_blank" rel="noopener noreferrer">“Carefree” — Kevin MacLeod (incompetech.com)</a><br/>Licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a> · 원본 음원, 재생 음량 조절·반복 재생</p>}
    </main>
    <nav class="bottom-nav" aria-label="청첩장 바로가기"><a href="#day">예식 안내</a><span></span><a href="#location">오시는 길</a>{showGallery && <><span></span><a href="#gallery">사진첩</a></>}</nav>
    <dialog id="lightbox" aria-label="사진 크게 보기"><div class="lb-top"><span id="lb-count" aria-live="polite"></span><button type="button" id="close-photo" aria-label="사진 닫기">×</button></div><div class="lb-track" id="lb-track">{w.photos.map(photo=><figure><img src={asset(photo.src)} alt={photo.alt} loading="lazy"/></figure>)}</div><button type="button" class="lb-nav lb-prev" aria-label="이전 사진">‹</button><button type="button" class="lb-nav lb-next" aria-label="다음 사진">›</button></dialog>
    <p id="toast" role="status" aria-live="polite"></p>
    {scrollTheme ? <ScrollThemes theme={theme}/> : <InvitationMotion />}
    {w.music.youtubeId ? <YouTubeMusic /> : <BackgroundMusic />}
    <script>
      const toast = document.querySelector<HTMLElement>('#toast')!;
      let timer: ReturnType<typeof setTimeout>;
      const notify=(message:string)=>{toast.textContent=message;toast.classList.add('visible');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('visible'),3500)};
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.dataset.copy!);notify('복사했어요.')}catch{notify('복사하지 못했어요. 표시된 내용을 직접 복사해 주세요.')}}));
      // Share: KakaoTalk feed card when a Kakao JavaScript key is set (SDK loaded on first tap);
      // without a key, the device's share sheet, then link copy. The second button always copies the link.
      const isLocal=['localhost','127.0.0.1'].includes(location.hostname);
      const shareUrl=location.origin+location.pathname;
      const meta=(p:string)=>document.querySelector<HTMLMetaElement>(`meta[property="${p}"]`)?.content||'';
      const copyLink=async()=>{try{await navigator.clipboard.writeText(shareUrl);notify('청첩장 링크를 복사했어요.')}catch{notify('복사하지 못했어요. 주소창의 링크를 복사해 주세요.')}};
      const kakaoKey=document.querySelector<HTMLElement>('.share-pair')?.dataset.kakaoKey||'';
      let kakaoReady:Promise<any>|null=null;
      const loadKakao=()=>kakaoReady??=new Promise((resolve,reject)=>{const k=(window as any).Kakao;if(k){resolve(k);return;}const sc=document.createElement('script');sc.src='https://t1.kakaocdn.net/kakao_js_sdk/2.7.4/kakao.min.js';sc.integrity='sha384-DKYJZ8NLiK8MN4/C5P2dtSmLQ4KwPaoqAfyA/DfmEc1VDxu4yyC7wy6K1Hs90nka';sc.crossOrigin='anonymous';sc.onload=()=>{const K=(window as any).Kakao;if(!K.isInitialized())K.init(kakaoKey);resolve(K)};sc.onerror=()=>{kakaoReady=null;reject(new Error('kakao'))};document.head.append(sc);});
      const nativeShare=async()=>{try{if(navigator.share)await navigator.share({title:meta('og:title')||document.title,url:shareUrl});else await copyLink();}catch(e){if(!(e instanceof Error&&e.name==='AbortError'))await copyLink();}};
      document.querySelector('#share-kakao')?.addEventListener('click',async()=>{
        if(isLocal){notify('로컬 미리보기예요. 배포 후 공유할 수 있어요.');return;}
        if(!kakaoKey){await nativeShare();return;}
        try{const K=await loadKakao();const link={mobileWebUrl:shareUrl,webUrl:shareUrl};const there={mobileWebUrl:shareUrl+'#location',webUrl:shareUrl+'#location'};
          K.Share.sendDefault({objectType:'feed',content:{title:meta('og:title'),description:meta('og:description'),imageUrl:meta('og:image'),imageWidth:1200,imageHeight:630,link},buttons:[{title:'청첩장 보기',link},{title:'오시는 길',link:there}]});
        }catch{await nativeShare();}
      });
      document.querySelector('#share-link')?.addEventListener('click',copyLink);
      // Draw the red-thread loop around the wedding day once the calendar comes into view.
      const calendar=document.querySelector<HTMLElement>('.calendar');
      if(calendar){const io=new IntersectionObserver(es=>{if(es.some(e=>e.isIntersecting)){calendar.classList.add('drawn');io.disconnect();}},{threshold:.5});io.observe(calendar);}
      const dialog=document.querySelector<HTMLDialogElement>('#lightbox')!;
      // Photo viewer: every gallery photo in one horizontal snap track, opened at the tapped one; swipe, arrows or keys move between them.
      const track=dialog.querySelector<HTMLElement>('#lb-track');
      const lbCount=dialog.querySelector<HTMLElement>('#lb-count');
      const total=track?track.children.length:0;
      const lbIndex=()=>track?Math.round(track.scrollLeft/Math.max(1,track.clientWidth)):0;
      const lbShow=(i:number,smooth=true)=>{if(!track)return;const k=Math.max(0,Math.min(total-1,i));track.scrollTo({left:k*track.clientWidth,behavior:smooth?'smooth':'auto'});};
      const lbSync=()=>{const i=lbIndex();if(lbCount)lbCount.textContent=`${i+1} / ${total}`;dialog.querySelector<HTMLButtonElement>('.lb-prev')!.disabled=i<=0;dialog.querySelector<HTMLButtonElement>('.lb-next')!.disabled=i>=total-1;};
      track?.addEventListener('scroll',lbSync,{passive:true});
      document.querySelectorAll<HTMLButtonElement>('[data-index]').forEach(button=>button.addEventListener('click',()=>{dialog.showModal();lbShow(Number(button.dataset.index),false);lbSync();}));
      dialog.querySelector('.lb-prev')?.addEventListener('click',()=>lbShow(lbIndex()-1));
      dialog.querySelector('.lb-next')?.addEventListener('click',()=>lbShow(lbIndex()+1));
      dialog.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')lbShow(lbIndex()-1);if(e.key==='ArrowRight')lbShow(lbIndex()+1);});
      document.querySelector('#close-photo')?.addEventListener('click',()=>dialog.close());
      dialog.addEventListener('click',e=>{if(e.target===dialog||(e.target as HTMLElement).tagName==='FIGURE')dialog.close()});
    </script>
  </body>
</html>
<style>
 .music-credit{padding:16px 24px 32px;margin:0;text-align:center;font:10px/1.8 sans-serif;color:#746d60;}
 .music-credit a{color:inherit;text-decoration:underline;}
</style>
