<section class="guestbook" id="guestbook">
  <h2>축하 한마디</h2>
  <p>남겨주신 이름과 글은 하객들과 함께 봅니다.</p>
  <form>
    <label>이름<input name="name" required maxlength="20" autocomplete="name" /></label>
    <label>한마디<textarea name="message" required maxlength="200" rows="2"></textarea></label>
    <label>글 관리 비밀번호<input name="password" type="password" required minlength="6" maxlength="128" autocomplete="new-password" /><small>6자 이상 · 수정·삭제할 때 필요해요. 다른 곳에서 쓰는 비밀번호는 피해주세요.</small></label>
    <div class="emoji-picks" role="group" aria-label="축하 이모지">
      {[['🤍','하얀 하트'], ['💐','꽃다발'], ['💍','반지'], ['🥂','건배']].map(([emoji, name]) =>
        <button type="button" data-emoji={emoji} aria-label={name + ' 넣기'}>{emoji}</button>
      )}
    </div>
    <button type="submit">한마디 남기기</button>
  </form>
  <p role="status" class="status"></p>
  <ul aria-label="축하 글" tabindex="-1"></ul>
  <nav class="pages" aria-label="축하 글 페이지" hidden></nav>
  <button type="button" class="admin-toggle">관리자 전용</button>
  <dialog aria-labelledby="manage-title">
    <form class="manage-form">
      <h3 id="manage-title">축하글 수정·삭제</h3>
      <div class="delete-preview" hidden>
        <span>삭제할 축하글</span>
        <strong class="preview-author"></strong>
        <p class="preview-message"></p>
      </div>
      <label class="edit-field">이름<input name="editName" maxlength="20" required /></label>
      <label class="edit-field">한마디<textarea name="editMessage" maxlength="200" rows="4" required></textarea></label>
      <label><span class="secret-label">글 관리 비밀번호</span><input name="secret" type="password" required maxlength="128" autocomplete="off" /></label>
      <p class="manage-status" role="status"></p>
      <div class="manage-actions">
        <button type="submit" class="save-edit">수정 저장</button>
        <button type="button" class="delete-entry">삭제</button>
        <button type="button" class="close-manage">취소</button>
      </div>
    </form>
  </dialog>
</section>
<script>
  const section = document.querySelector<HTMLElement>('#guestbook')!;
  const form = section.querySelector('form')!;
  const status = section.querySelector<HTMLElement>('.status')!;
  const list = section.querySelector('ul')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const message = form.querySelector('textarea')!;
  for (const pick of form.querySelectorAll<HTMLButtonElement>('[data-emoji]')) {
    pick.addEventListener('click', () => {
      const emoji = pick.dataset.emoji!;
      const start = message.selectionStart;
      const end = message.selectionEnd;
      if (message.value.length - (end - start) + emoji.length > message.maxLength) {
        status.textContent = '한마디가 길어요. 글을 조금 줄이면 이모지를 넣을 수 있어요.';
        return;
      }
      message.setRangeText(emoji, start, end, 'end');
      message.focus({preventScroll:true});
      status.textContent = '';
    });
  }
  const endpoint = 'https://wedding-guestbook.ygjang.workers.dev/messages';
  type Entry = {id:number; name:string; message:string; editable:number};
  let adminMode = false;
  let currentPage = 1;
  let selected: Entry | null = null;
  let pending = false;
  const dialog = section.querySelector('dialog')!;
  const manage = section.querySelector<HTMLFormElement>('.manage-form')!;
  const feedback = section.querySelector<HTMLElement>('.manage-status')!;
  const field = (name:string) => manage.elements.namedItem(name) as HTMLInputElement;
  const adminToggle = section.querySelector<HTMLButtonElement>('.admin-toggle')!;
  adminToggle.addEventListener('click', () => {
    adminMode = !adminMode;
    adminToggle.textContent = adminMode ? '관리 종료' : '관리자 전용';
    loadMessages(currentPage);
  });
  section.querySelector('.close-manage')!.addEventListener('click',()=>dialog.close());
  dialog.addEventListener('close',()=>{field('secret').value='';});
  function openManage(data:Entry) {
    selected=data;
    manage.querySelector<HTMLElement>('.delete-preview')!.hidden=!adminMode;
    manage.querySelector('.preview-author')!.textContent=data.name;
    manage.querySelector('.preview-message')!.textContent=data.message;
    field('editName').value=data.name;
    field('editMessage').value=data.message;
    field('secret').value='';
    feedback.textContent='';
    manage.querySelectorAll<HTMLElement>('.edit-field,.save-edit').forEach(el=>el.hidden=adminMode);
    field('editName').required=!adminMode;
    field('editMessage').required=!adminMode;
    section.querySelector('.secret-label')!.textContent=adminMode ? '관리자 키' : '글 관리 비밀번호';
    section.querySelector('#manage-title')!.textContent=adminMode ? '관리자 글 삭제' : '축하글 수정·삭제';
    dialog.showModal();
  }
  async function changeEntry(remove=false) {
    if(pending || !selected || !manage.reportValidity()) return;
    if(remove && !confirm('이 축하글을 삭제할까요? 삭제하면 되돌릴 수 없습니다.')) return;
    pending=true;
    manage.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.disabled=true);
    try {
      const payload = adminMode ? {adminToken:field('secret').value} : {password:field('secret').value,name:field('editName').value,message:field('editMessage').value};
      const result=await fetch(endpoint+'/'+selected.id,{method:remove?'DELETE':'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
      if(!result.ok) {
        feedback.textContent=result.status===429 ? '시도가 많아요. 1분 뒤 다시 시도해 주세요.' : result.status===404 ? '이미 삭제된 글입니다.' : result.status===403 ? '비밀번호 또는 관리자 키를 확인해 주세요.' : '입력 내용과 연결을 확인해 주세요.';
        return;
      }
      dialog.close();
      status.textContent=remove?'글을 삭제했습니다.':'글을 수정했습니다.';
      await loadMessages(currentPage);
    } catch {feedback.textContent='연결을 확인하고 다시 시도해 주세요.';}
    finally {pending=false;manage.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.disabled=false);}
  }
  manage.addEventListener('submit',event=>{event.preventDefault();changeEntry();});
  section.querySelector('.delete-entry')!.addEventListener('click',()=>changeEntry(true));
  function entry(data: Entry) {
    const {name,message}=data;
    const item = document.createElement('li');
    const author = document.createElement('strong');
    const text = document.createElement('p');
    author.textContent = name;
    text.textContent = message;
    item.append(author, text);
    if(data.editable || adminMode) {
      const action=document.createElement('button');
      action.type='button';
      action.className='entry-manage';
      action.textContent=adminMode?'관리자 삭제':'수정 · 삭제';
      action.setAttribute('aria-label',name+'님의 글 '+action.textContent);
      action.addEventListener('click',()=>openManage(data));
      item.append(action);
    }
    return item;
  }
  const pages = section.querySelector<HTMLElement>('.pages')!;
  let latestRequest = 0;
  async function loadMessages(number = 1, focusList = false) {
    const request = ++latestRequest;
    try {
      const response = await fetch(endpoint + '?page=' + number);
      if (!response.ok) throw new Error();
      const data: {items: Entry[]; page:number; pages:number} = await response.json();
      if (request !== latestRequest) return;
      currentPage=data.page;
      list.replaceChildren(...data.items.map(item => entry(item)));
      pages.replaceChildren();
      pages.hidden = data.pages <= 1;
      const add = (label: string, target: number) => {
        const control = document.createElement('button');
        control.type = 'button';
        control.textContent = label;
        control.setAttribute('aria-label', label === '이전' || label === '다음' ? label + ' 페이지' : target + '페이지');
        if (target === data.page) control.setAttribute('aria-current', 'page');
        else control.addEventListener('click', () => loadMessages(target, true));
        pages.append(control);
      };
      const start = Math.max(1, Math.min(data.page - 1, data.pages - 2));
      if (data.page > 1) add('이전', data.page - 1);
      for (let i = start; i <= Math.min(data.pages, start + 2); i++) add(String(i), i);
      if (data.page < data.pages) add('다음', data.page + 1);
      if (focusList) list.focus();
    } catch {
      if (request === latestRequest) status.textContent = '글 목록을 불러오지 못했어요. 새로고침해 주세요.';
    }
  }
  loadMessages();
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (button.disabled) return;
    button.disabled = true;
    const data = new FormData(form);
    try {
      const response = await fetch(endpoint, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(data))});
      if (!response.ok) {
        status.textContent = response.status === 429 ? '잠시 후 다시 남겨 주세요.' : '이름과 한마디를 확인한 뒤 다시 시도해 주세요.';
        return;
      }

      form.reset();
      status.textContent = '축하 글을 남겼습니다.';
      await loadMessages(1);
    } catch { status.textContent = '연결을 확인하고 다시 시도해 주세요.'; }
    finally {button.disabled = false;}
  });
</script>
<style>
  .guestbook form,.guestbook ul{max-width:360px;margin:24px auto 0;text-align:left;}
  .guestbook label{display:grid;gap:6px;margin-bottom:14px;font-size:13px;}
  .guestbook input,.guestbook textarea{box-sizing:border-box;width:100%;padding:10px 12px;background:#fffdfa;border:1px solid var(--line);color:var(--ink);font:16px/1.5 var(--serif);border-radius:4px;}
  .guestbook button{width:100%;padding:12px;background:var(--ink);color:var(--paper);border:0;font:14px var(--serif);cursor:pointer;}
  .guestbook>p{margin-top:12px;font-size:13px;}
  .emoji-picks{display:flex;gap:4px;margin:-8px 0 12px;}
  .emoji-picks button{width:44px;height:44px;padding:0;background:transparent;color:var(--ink);font-size:20px;border-radius:50%;}
  .emoji-picks button:hover,.emoji-picks button:focus-visible{background:#f4efe7;}
  .guestbook ul{padding:0;list-style:none;}
  .guestbook :global(li){margin:12px 0;padding:16px 18px;background:#fffcf7;border:1px solid #e8dfd2;border-radius:8px;word-break:keep-all;overflow-wrap:anywhere;}
  .guestbook :global(li strong){display:block;color:#6b5144;font:600 13px/1.6 var(--sans);}
  .guestbook :global(li strong)::before{content:"보낸 이";font-weight:400;color:#756b61;margin-right:8px;}
  .guestbook :global(li p){margin:8px 0 0;color:#372f2a;font:16px/1.7 var(--serif);white-space:pre-wrap;}
  .pages{display:flex;justify-content:center;gap:2px;margin:16px auto 0;}
  .pages[hidden]{display:none;}
  .pages :global(button){width:auto;min-width:40px;min-height:44px;padding:6px;color:var(--ink);background:transparent;border:0;border-radius:6px;cursor:pointer;}
  .pages :global([aria-current="page"]){background:#eee6da;font-weight:700;}
  .guestbook small{font:12px/1.6 var(--sans);color:#756b61;}
  .guestbook :global(.entry-manage),.guestbook .admin-toggle{width:auto;background:transparent;color:#756b61;font-size:12px;min-height:44px;padding:10px 0;}
  .guestbook .admin-toggle{margin-top:20px;}
  dialog{box-sizing:border-box;width:min(92vw,400px);max-height:90dvh;overflow:auto;padding:24px;border:1px solid #e8dfd2;border-radius:12px;background:#fffcf7;color:#372f2a;}
  dialog::backdrop{background:#0006;}
  .guestbook dialog form{margin:0;}
  dialog h3{margin:0 0 20px;}
  .manage-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;}
  .manage-actions button{flex:1;min-height:44px;border-radius:4px;}
  .guestbook .delete-entry{background:transparent;border:1px solid #a7786c;color:#805348;}
  .guestbook .close-manage{background:transparent;color:#756b61;}
  .guestbook .delete-entry:hover{background:#f8eee9;}
  .delete-preview{padding:14px 16px;margin:0 0 20px;border:1px solid #e8dfd2;border-radius:8px;background:#f7f2eb;word-break:keep-all;overflow-wrap:anywhere;}
  .delete-preview span{display:block;margin-bottom:8px;font:12px var(--sans);color:#756b61;}
  .delete-preview strong{font:600 14px/1.6 var(--sans);}
  .delete-preview p{margin:8px 0 0;font:16px/1.7 var(--serif);white-space:pre-wrap;}
  .manage-status{font-size:13px;}
  [hidden]{display:none!important;}
</style>
