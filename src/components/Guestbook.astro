<section class="guestbook" id="guestbook">
  <h2>축하 한마디</h2>
  <p>남겨주신 이름과 글은 하객들과 함께 봅니다.</p>
  <form>
    <label>이름<input name="name" required maxlength="20" autocomplete="name" /></label>
    <label>한마디<textarea name="message" required maxlength="200" rows="2"></textarea></label>
    <div class="emoji-picks" role="group" aria-label="축하 이모지">
      {[['🤍','하얀 하트'], ['💐','꽃다발'], ['💍','반지'], ['🥂','건배']].map(([emoji, name]) =>
        <button type="button" data-emoji={emoji} aria-label={name + ' 넣기'}>{emoji}</button>
      )}
    </div>
    <button type="submit">한마디 남기기</button>
  </form>
  <p role="status" class="status"></p>
  <ul aria-label="축하 글" tabindex="-1"></ul>
  <nav class="pages" aria-label="축하 글 페이지" hidden></nav>
</section>
<script>
  const section = document.querySelector<HTMLElement>('#guestbook')!;
  const form = section.querySelector('form')!;
  const status = section.querySelector<HTMLElement>('.status')!;
  const list = section.querySelector('ul')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const message = form.querySelector('textarea')!;
  for (const pick of form.querySelectorAll<HTMLButtonElement>('[data-emoji]')) {
    pick.addEventListener('click', () => {
      const emoji = pick.dataset.emoji!;
      const start = message.selectionStart;
      const end = message.selectionEnd;
      if (message.value.length - (end - start) + emoji.length > message.maxLength) {
        status.textContent = '한마디가 길어요. 글을 조금 줄이면 이모지를 넣을 수 있어요.';
        return;
      }
      message.setRangeText(emoji, start, end, 'end');
      message.focus({preventScroll:true});
      status.textContent = '';
    });
  }
  const endpoint = 'https://wedding-guestbook.ygjang.workers.dev/messages';
  function entry(name: string, message: string) {
    const item = document.createElement('li');
    const author = document.createElement('strong');
    const text = document.createElement('p');
    author.textContent = name;
    text.textContent = message;
    item.append(author, text);
    return item;
  }
  const pages = section.querySelector<HTMLElement>('.pages')!;
  let latestRequest = 0;
  async function loadMessages(number = 1, focusList = false) {
    const request = ++latestRequest;
    try {
      const response = await fetch(endpoint + '?page=' + number);
      if (!response.ok) throw new Error();
      const data: {items: {name:string; message:string}[]; page:number; pages:number} = await response.json();
      if (request !== latestRequest) return;
      list.replaceChildren(...data.items.map(item => entry(item.name, item.message)));
      pages.replaceChildren();
      pages.hidden = data.pages <= 1;
      const add = (label: string, target: number) => {
        const control = document.createElement('button');
        control.type = 'button';
        control.textContent = label;
        control.setAttribute('aria-label', label === '이전' || label === '다음' ? label + ' 페이지' : target + '페이지');
        if (target === data.page) control.setAttribute('aria-current', 'page');
        else control.addEventListener('click', () => loadMessages(target, true));
        pages.append(control);
      };
      const start = Math.max(1, Math.min(data.page - 1, data.pages - 2));
      if (data.page > 1) add('이전', data.page - 1);
      for (let i = start; i <= Math.min(data.pages, start + 2); i++) add(String(i), i);
      if (data.page < data.pages) add('다음', data.page + 1);
      if (focusList) list.focus();
    } catch {
      if (request === latestRequest) status.textContent = '글 목록을 불러오지 못했어요. 새로고침해 주세요.';
    }
  }
  loadMessages();
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (button.disabled) return;
    button.disabled = true;
    const data = new FormData(form);
    try {
      const response = await fetch(endpoint, {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(data))});
      if (!response.ok) {
        status.textContent = response.status === 429 ? '잠시 후 다시 남겨 주세요.' : '이름과 한마디를 확인한 뒤 다시 시도해 주세요.';
        return;
      }

      form.reset();
      status.textContent = '축하 글을 남겼습니다.';
      await loadMessages(1);
    } catch { status.textContent = '연결을 확인하고 다시 시도해 주세요.'; }
    finally {button.disabled = false;}
  });
</script>
<style>
  .guestbook form,.guestbook ul{max-width:360px;margin:24px auto 0;text-align:left;}
  .guestbook label{display:grid;gap:6px;margin-bottom:14px;font-size:13px;}
  .guestbook input,.guestbook textarea{box-sizing:border-box;width:100%;padding:10px 12px;background:#fffdfa;border:1px solid var(--line);color:var(--ink);font:16px/1.5 var(--serif);border-radius:4px;}
  .guestbook button{width:100%;padding:12px;background:var(--ink);color:var(--paper);border:0;font:14px var(--serif);cursor:pointer;}
  .guestbook>p{margin-top:12px;font-size:13px;}
  .emoji-picks{display:flex;gap:4px;margin:-8px 0 12px;}
  .emoji-picks button{width:44px;height:44px;padding:0;background:transparent;color:var(--ink);font-size:20px;border-radius:50%;}
  .emoji-picks button:hover,.emoji-picks button:focus-visible{background:#f4efe7;}
  .guestbook ul{padding:0;list-style:none;}
  .guestbook :global(li){margin:12px 0;padding:16px 18px;background:#fffcf7;border:1px solid #e8dfd2;border-radius:8px;word-break:keep-all;overflow-wrap:anywhere;}
  .guestbook :global(li strong){display:block;color:#6b5144;font:600 13px/1.6 var(--sans);}
  .guestbook :global(li strong)::before{content:"보낸 이";font-weight:400;color:#756b61;margin-right:8px;}
  .guestbook :global(li p){margin:8px 0 0;color:#372f2a;font:16px/1.7 var(--serif);white-space:pre-wrap;}
  .pages{display:flex;justify-content:center;gap:2px;margin:16px auto 0;}
  .pages[hidden]{display:none;}
  .pages :global(button){width:auto;min-width:40px;min-height:44px;padding:6px;color:var(--ink);background:transparent;border:0;border-radius:6px;cursor:pointer;}
  .pages :global([aria-current="page"]){background:#eee6da;font-weight:700;}
</style>
