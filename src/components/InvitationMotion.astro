<script>
  // Static previews and reduced-motion visitors get the complete, still invitation.
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('.new-hero, .hero');
  let cleanup = () => {};
  const start = () => {
    cleanup();
    if (!hero) return;
    const preview = new URLSearchParams(location.search).get('motion') === 'off';
    hero.dataset.motion = preference.matches ? 'reduced' : preview ? 'preview' : 'active';
    if (preference.matches || preview) return;
    const animations: Animation[] = [];
    const enter = (element: Element, delay: number) => {
      animations.push(element.animate([
        { opacity: 0, transform: 'translateY(16px)' },
        { opacity: 1, transform: 'translateY(0)' },
      ], { duration: 850, delay, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' }));
    };
    // Don't replay an entrance when opening a deep link or restoring scroll position.
    if (!location.hash && window.scrollY < 40) {
      Array.from(hero.children).forEach((element, i) => enter(element, Math.min(i * 110, 550)));
      hero.querySelectorAll<SVGPathElement>('.botanical path, .ribbon-drawing path, .ribbon-drawing ellipse').forEach(path => {
        const length = path.getTotalLength();
        animations.push(path.animate([
          { strokeDasharray: `${length}`, strokeDashoffset: length },
          { strokeDasharray: `${length}`, strokeDashoffset: 0 },
        ], { duration: 1900, delay: 80, easing: 'ease-in-out' }));
      });
    }
    // Keep content visible before JS runs; animate only when it enters view.
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        enter(entry.target, 0);
        observer.unobserve(entry.target);
      }
    }, { threshold: .12 });
    document.querySelectorAll('.invitation h2, .invitation .letter, .gallery h2, .photo-grid, footer h2').forEach(element => observer.observe(element));

    const picture = hero.querySelector<HTMLElement>('.refined-photo, .ribbon-photo, .editorial-photo, .hero-photo');
    let frame = 0;
    let visible = true;
    const update = () => {
      frame = 0;
      if (!picture) return;
      const rect = hero.getBoundingClientRect();
      const progress = Math.max(0, Math.min(1, -rect.top / rect.height));
      picture.style.setProperty('--scroll-scale', String(1 + progress * .045));
      picture.style.setProperty('--scroll-shift', `${progress * 18}px`);
    };
    const schedule = () => { if (visible && !frame) frame = requestAnimationFrame(update); };
    const heroObserver = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; if (visible) schedule(); });
    heroObserver.observe(hero);
    picture?.classList.add('scroll-picture');
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
    cleanup = () => {
      observer.disconnect(); heroObserver.disconnect(); cancelAnimationFrame(frame);
      animations.forEach(animation => animation.cancel());
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      picture?.classList.remove('scroll-picture');
      picture?.style.removeProperty('--scroll-scale');
      picture?.style.removeProperty('--scroll-shift');
    };
  };
  start();
  preference.addEventListener('change', start);
  window.addEventListener('pagehide', () => cleanup());
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
</script>
<style is:global>
  .scroll-picture { overflow: hidden; }
  .scroll-picture > img,
  .scroll-picture > .botanical,
  .scroll-picture > .photo-placeholder,
  .scroll-picture > .frame-corner {
    transform: translateY(var(--scroll-shift, 0px)) scale(var(--scroll-scale, 1));
    transform-origin: center;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto !important; }
    .scroll-picture > * { transform: none !important; }
  }
</style>
