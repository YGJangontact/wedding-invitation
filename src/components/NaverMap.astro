---
import { wedding } from '../data/wedding';
const clientId = import.meta.env.PUBLIC_NAVER_MAP_CLIENT_ID || '';
---
<div class="naver-map-shell" data-map-client={clientId} data-map-address={wedding.address}>
  <div class="map-interaction-frame">
    <div id="venue-map" aria-label="아벤티움 위치를 표시하는 네이버 지도" inert></div>
  </div>
  <button class="map-unlock" hidden aria-pressed="false">지도를 클릭해 이동·확대하기</button>
  <p class="map-status" role="status">네이버 지도를 불러오는 중입니다.</p>
</div>
<script>
  // Browser SDK Client ID only. Never embed the Naver Client Secret.
  const shell = document.querySelector<HTMLElement>('.naver-map-shell')!;
  const status = shell.querySelector<HTMLElement>('.map-status')!;
  const host = document.querySelector<HTMLElement>('#venue-map')!;
  const unlock = shell.querySelector<HTMLButtonElement>('.map-unlock')!;
  const reset = () => { host.inert=true; unlock.hidden=false; unlock.textContent='지도를 클릭해 이동·확대하기'; unlock.setAttribute('aria-pressed','false'); };
  const activate = () => {if(host.dataset.ready!=='true')return;host.inert=false;unlock.textContent='지도 조작 중 · 바깥을 누르면 종료돼요';unlock.setAttribute('aria-pressed','true');};
  unlock.addEventListener('click',activate);
  shell.querySelector('.map-interaction-frame')?.addEventListener('click',activate);
  document.addEventListener('pointerdown',e=>{if(!host.inert&&!shell.contains(e.target as Node))reset();});
  document.addEventListener('focusin',e=>{if(!host.inert&&!shell.contains(e.target as Node))reset();});
  shell.addEventListener('keydown',e=>{if(e.key==='Escape'&&!host.inert){reset();unlock.focus({preventScroll:true});}});
  const win = window as any;
  let failed = false;
  let timer: ReturnType<typeof setTimeout>;
  const fail = () => {
    failed = true;
    clearTimeout(timer);
    host.hidden = true;
    unlock.hidden = true;
    status.textContent = '지도를 불러오지 못했어요. 아래 네이버 지도에서 위치와 길찾기를 확인해 주세요.';
  };
  function start() {
    if (!shell.dataset.mapClient) { fail(); return; }
    win.navermap_authFailure = fail;
    timer = setTimeout(fail, 18000);
    const script = document.createElement('script');
    script.src = `https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=${encodeURIComponent(shell.dataset.mapClient)}&submodules=geocoder&callback=initWeddingMap`;
    script.async = true;
    script.onerror = fail;
    win.initWeddingMap = () => {
      if (failed || !win.naver?.maps?.Service) { fail(); return; }
      const n = win.naver.maps;
      n.Service.geocode({query:shell.dataset.mapAddress}, (code:any, response:any) => {
        if (failed) return;
        const addresses = response?.v2?.addresses;
        if (code !== n.Service.Status.OK || addresses?.length !== 1) { fail(); return; }
        const address = addresses[0];
        if (!address.roadAddress?.includes('청파로 464')) { fail(); return; }
        const point = new n.LatLng(Number(address.y), Number(address.x));
        const map = new n.Map(host, {center:point,zoom:16,scrollWheel:false,zoomControl:true,zoomControlOptions:{position:n.Position.TOP_RIGHT}});
        new n.Marker({map,position:point,title:'아벤티움 · 브라운스톤서울 3층',icon:{content:'<div class="map-pin"><span class="map-pin-name">아벤티움</span><span class="map-pin-dot"></span></div>',anchor:new n.Point(44,43)}});
        n.Event.once(map,'tilesloaded',()=>{
          if(failed) return;
          clearTimeout(timer);
          status.textContent = '브라운스톤서울 3층';
          reset();
          host.dataset.ready = 'true';
        });
        new ResizeObserver(()=>map.setSize(new n.Size(host.clientWidth,host.clientHeight))).observe(host);
      });
    };
    document.head.append(script);
  }
  // Load only when guests approach the directions section.
  const observer = new IntersectionObserver(entries=>{
    if(entries.some(e=>e.isIntersecting)){observer.disconnect();start();}
  },{rootMargin:'250px'});
  observer.observe(shell);
</script>
<style>
 .map-interaction-frame{position:relative;}
 .map-interaction-frame:has([inert]){cursor:pointer;touch-action:pan-y;}
 .map-unlock{display:block;margin:12px auto 0;padding:9px 14px;border:0;background:transparent;color:#65563e;font:12px/1.6 var(--serif);cursor:pointer;text-decoration:underline;text-underline-offset:4px;}
 .map-unlock[hidden]{display:none;}
 .map-unlock:focus-visible{outline:2px solid #766647;outline-offset:2px;}
</style>
