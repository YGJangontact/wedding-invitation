---
// Gallery: one large rounded photo at a time that swipes sideways and moves on by itself every 4 seconds,
// with a row of black-and-white circles below where the current photo grows and turns to colour.
// Tapping a photo opens the full-screen viewer (#lightbox, via data-index).
import { wedding as w } from '../data/wedding';
const { asset } = Astro.props;
const total = w.photos.length;
---
<div class="pswipe">
  <div class="ps-track">
    {w.photos.map((photo, i) => <button type="button" class="ps-slide" data-index={i} aria-label={`${photo.alt} 크게 보기`}>
      <span class="ps-pic"><img src={asset(photo.src)} alt={photo.alt} loading={i < 2 ? 'eager' : 'lazy'} /></span>
    </button>)}
  </div>
  <div class="ps-thumbs" role="group" aria-label="사진 고르기"><div class="ps-strip">
    {w.photos.map((photo, i) => <button type="button" data-go={i} aria-label={`${i + 1}번째 사진 보기`}><img src={asset(photo.src)} alt="" loading="lazy" /></button>)}</div>
  </div>
  <p class="ps-count" aria-live="polite">1 / {total}</p>
</div>
<script>
  const root = document.querySelector<HTMLElement>('.pswipe');
  if (root) {
    const track = root.querySelector<HTMLElement>('.ps-track')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.ps-slide'));
    const thumbs = root.querySelector<HTMLElement>('.ps-thumbs')!;
    const strip = thumbs.querySelector<HTMLElement>('.ps-strip')!;
    const dots = Array.from(strip.children) as HTMLElement[];
    let shown = -1;
    const count = root.querySelector<HTMLElement>('.ps-count')!;
    const total = slides.length;
    let cur = 0, frame = 0;

    // Glide to a photo over ~1.1s with a soft ease, instead of the browser's quick smooth-scroll.
    // Snapping is switched off while gliding so it cannot cut the motion short.
    let glide = 0;
    const go = (i: number) => {
      const el = slides[(i + total) % total];
      const from = track.scrollLeft, to = el.offsetLeft - (track.clientWidth - el.offsetWidth) / 2;
      const dist = Math.abs(to - from), ms = Math.min(1600, 900 + dist * 0.25);
      const start = performance.now();
      const ease = (t: number) => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      cancelAnimationFrame(glide);
      track.style.scrollSnapType = 'none';
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        track.scrollLeft = from + (to - from) * ease(t);
        if (t < 1) glide = requestAnimationFrame(step);
        else { glide = 0; track.style.scrollSnapType = ''; }
      };
      glide = requestAnimationFrame(step);
    };
    // A finger on the track takes over from any glide in progress.
    track.addEventListener('pointerdown', () => { if (glide) { cancelAnimationFrame(glide); glide = 0; track.style.scrollSnapType = ''; } }, { passive: true });
    const render = () => {
      frame = 0;
      const mid = track.scrollLeft + track.clientWidth / 2;
      const step = total > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : 1;
      let best = Infinity;
      slides.forEach((el, i) => {
        const d = (el.offsetLeft + el.offsetWidth / 2 - mid) / step;
        if (Math.abs(d) < best) { best = Math.abs(d); cur = i; }
        const a = Math.min(1, Math.abs(d));
        el.style.transform = `scale(${1 - 0.05 * a})`;
        el.style.opacity = String(1 - 0.5 * a);
      });
      if (cur !== shown) {
        shown = cur;
        dots.forEach((dot, k) => { dot.classList.toggle('on', k === cur); dot.classList.toggle('near', Math.abs(k - cur) === 1); });
        // Slide the circle row so the current circle ends up centred. The row's offset and the circles'
        // sizes change over the same time with the same ease, so the current circle stays centred all the way.
        const size = (k: number) => k === cur ? 56 : Math.abs(k - cur) === 1 ? 42 : 34;
        let x = 0;
        for (let k = 0; k < cur; k++) x += size(k) + 8;
        strip.style.transform = `translateX(${thumbs.clientWidth / 2 - (x + size(cur) / 2)}px)`;
      }
      count.textContent = `${cur + 1} / ${total}`;
    };
    track.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(render); }, { passive: true });
    dots.forEach((dot, k) => dot.addEventListener('click', () => { pauseUntil = Date.now() + 8000; go(k); }));
    new ResizeObserver(() => { shown = -1; render(); }).observe(track);
    render();

    // Move on every 4 seconds while the gallery is on screen; a touch pauses it for 8 seconds.
    const motion = new URLSearchParams(location.search).get('motion');
    const still = motion !== 'on' && (motion === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches);
    let pauseUntil = 0, visible = false;
    ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach(ev => root.addEventListener(ev, () => { pauseUntil = Date.now() + 8000; }, { passive: true }));
    new IntersectionObserver(entries => { visible = entries.some(e => e.isIntersecting); }, { threshold: 0.4 }).observe(track);
    if (!still && total > 1) setInterval(() => {
      const viewerOpen = document.querySelector<HTMLDialogElement>('#lightbox')?.open;
      if (visible && !viewerOpen && !document.hidden && Date.now() > pauseUntil) go(cur + 1);
    }, 4000);
  }
</script>
<style>
  .pswipe { margin-top:28px; }
  .ps-track { position:relative; display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:6px 0 10px; margin:0 -24px; }
  .ps-track::-webkit-scrollbar { display:none; }
  .ps-track::before, .ps-track::after { content:""; flex:0 0 7%; }
  .ps-slide { flex:0 0 86%; scroll-snap-align:center; border:0; padding:0; background:none; cursor:zoom-in; transition:none; }
  .ps-pic { display:block; aspect-ratio:4 / 5; border-radius:24px; overflow:hidden; background:var(--sage, #ece5da); }
  .ps-pic img { display:block; width:100%; height:100%; object-fit:cover; object-position:center 30%; }
  .ps-thumbs { height:64px; overflow:hidden; margin:4px -24px 0; }
  .ps-strip { display:flex; align-items:center; gap:8px; height:100%; width:max-content; transition:transform .7s cubic-bezier(.4,0,.2,1); }
  .ps-thumbs button { flex:0 0 auto; width:34px; height:34px; padding:2px; border:2px solid transparent; border-radius:50%; background:none; cursor:pointer; transition:width .7s cubic-bezier(.4,0,.2,1), height .7s cubic-bezier(.4,0,.2,1), border-color .7s ease; }
  .ps-thumbs button.near { width:42px; height:42px; }
  .ps-thumbs button.on { width:56px; height:56px; border-color:var(--green); }
  .ps-thumbs img { display:block; width:100%; height:100%; border-radius:50%; object-fit:cover; filter:grayscale(1); opacity:.85; transition:filter .8s ease, opacity .8s ease; }
  .ps-thumbs button.on img { filter:none; opacity:1; }
  .ps-count { margin:6px 0 0; font-size:12px; color:var(--muted); font-variant-numeric:tabular-nums; }
</style>
